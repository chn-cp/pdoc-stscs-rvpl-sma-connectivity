# Project and restricted-input locations
RVPL_SMA_PROJECT_ROOT=/path/to/project
RVPL_SMA_DISCOVERY_DIR=/path/to/restricted/discovery_analysis
RVPL_SMA_SUPPLEMENT_INPUTS_DIR=/path/to/restricted/supplement_inputs
RVPL_SMA_PRIOR_SUBMISSION_DIR=/path/to/restricted/prior_submission

# Outputs
RVPL_SMA_VALIDATION_OUTPUT=/path/to/output/statistical_validation
RVPL_SMA_VERIFICATION_OUTPUT=/path/to/output/verification
RVPL_SMA_SENSITIVITY_OUTPUT=/path/to/output/preprocessing_provenance

# Preprocessing-provenance sensitivity inputs
RVPL_SMA_MASTER_COHORT=/path/to/restricted/master_imaging_cohort_n30.csv
RVPL_SMA_QC_LEDGER=/path/to/restricted/qc33_deidentified.csv
RVPL_SMA_BASELINE_RESULTS=/path/to/restricted/robustness_uniform5000.csv

# Optional numerical accelerator
FIRTH_ACCELERATOR_LIB=/path/to/firth_accelerator.dll
RTOOLS_BIN=/path/to/rtools/bin

# External atlas / visualization resources
JULICH_ATLAS_ROOT=/path/to/JulichBrainAtlas_3.1
BRAINNET_SURFACE_ROOT=/path/to/BrainNetViewer/Data/SurfTemplate
RVPL_SMA_SPATIAL_INPUT=/path/to/restricted/spatial_convergence
RVPL_SMA_PREVIOUS_SMA_ANNOTATION=/path/to/restricted/previous_sma_annotation
RVPL_SMA_SPATIAL_OUTPUT=/path/to/output/sma6mp_spatial
